<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= title || 'ELITE24.CD' %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css">
</head>
<body class="home-page">
<header class="mock-header">
  <div class="mock-utility">
    <span><strong>ELITE24.CD</strong> · Beni, Est RDC</span>
    <span><%= new Date().toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %></span>
    <span class="mock-utility-links"><a href="/contact">Contact rédaction</a></span>
  </div>
  <div class="mock-masthead">
    <a class="mock-logo" href="/">ÉLITE<span>24</span>.CD</a>
    <div class="mock-tagline"><strong>L'INFO D'EXCELLENCE</strong><span>La voix de l'Est en ligne</span></div>
    <div class="mock-search" aria-label="Recherche">⌕ <span>Rechercher une actualité...</span></div>
  </div>
  <nav class="mock-nav" aria-label="Navigation principale">
    <a class="active" href="/">À la une</a>
    <% categories.forEach(category => { %><a href="/categorie/<%= category.slug %>"><%= category.nom %></a><% }) %>
    <a href="/a-propos">À propos</a>
  </nav>
</header>
<div class="mock-flash">
  <strong><span class="flash-dot"></span> FLASH INFO</strong>
  <div class="mock-ticker">
    <a href="/article/<%= articles[0] ? articles[0].slug : '' %>"><%= articles[0] ? articles[0].titre : 'L’actualité de la République démocratique du Congo en continu.' %></a>
    <a aria-hidden="true" href="/article/<%= articles[0] ? articles[0].slug : '' %>"><%= articles[0] ? articles[0].titre : 'L’actualité de la République démocratique du Congo en continu.' %></a>
  </div>
</div>
<main class="mock-main">
  <div class="mock-intro">
    <div><p class="mock-kicker">FIL DE L'ACTUALITÉ · <%= new Date().toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) %></p><h1><%= title || 'L’essentiel de l’actualité' %></h1><p>Les faits, les voix et les sujets qui comptent en République démocratique du Congo et dans la région.</p></div>
    <span class="mock-location">Beni · 24°C</span>
  </div>
  <% if (articles.length) { %>
  <section class="mock-feature-grid">
    <% if (featured) { %>
    <article class="mock-hero-card">
      <% if (featured.coverImage) { %><img src="<%= imageUrl(featured.coverImage) %>" alt="<%= featured.titre %>" loading="eager" decoding="async"><% } else { %><div class="mock-image-placeholder">ELITE24.CD</div><% } %>
      <div class="mock-hero-copy"><span class="mock-category"><%= featured.category ? featured.category.nom : 'Actualité' %></span><h2><a href="/article/<%= featured.slug %>"><%= featured.titre %></a></h2><p><%= featured.contenu.replace(/<[^>]*>/g, '').slice(0, 230) %>...</p><div class="mock-meta"><span>Par <%= featured.author ? featured.author.username : 'La rédaction' %></span><a href="/article/<%= featured.slug %>">Lire l'article complet →</a></div></div>
    </article>
    <% } %>
    <aside class="mock-side-stories"><p class="mock-section-title">À la une</p><% popular.slice(0, 3).forEach(article => { %><a class="mock-side-story" href="/article/<%= article.slug %>"><span><%= article.category ? article.category.nom : 'Actualité' %></span><strong><%= article.titre %></strong><small>Par <%= article.author ? article.author.username : 'La rédaction' %></small></a><% }) %></aside>
  </section>
  <section class="mock-latest"><div class="mock-section-heading"><h2>Dernières actualités</h2><span><%= articles.length %> publication<%= articles.length === 1 ? '' : 's' %></span></div><div class="mock-article-grid"><% articles.forEach(article => { %><a class="mock-article-card" href="/article/<%= article.slug %>"><% if (article.coverImage) { %><img src="<%= imageUrl(article.coverImage) %>" alt="<%= article.titre %>" loading="lazy" decoding="async"><% } else { %><div class="mock-card-placeholder"><%= article.category ? article.category.nom : 'ACTU' %></div><% } %><div><span class="mock-category"><%= article.category ? article.category.nom : 'Actualité' %></span><h3><%= article.titre %></h3><small><%= article.publishedAt ? new Date(article.publishedAt).toLocaleDateString('fr-FR') : 'À la une' %> · <%= article.viewsCount %> vues</small></div></a><% }) %></div></section>
  <% } else { %><p class="empty">Aucun article publié pour le moment.</p><% } %>
</main>
<section class="mock-editorial-band"><div><span class="mock-kicker">NOTRE ENGAGEMENT</span><h2>Informer avec rigueur,<br>au plus près du terrain.</h2><p>Une information claire, fiable et proche des communautés de la République démocratique du Congo.</p></div><a href="/a-propos">En savoir plus →</a></section>
<footer class="mock-footer"><div><a class="mock-logo footer-logo" href="/">ÉLITE<span>24</span>.CD</a><p>La voix de l'Est en ligne.</p></div><div><strong>EXPLORER</strong><a href="/">À la une</a><a href="/a-propos">À propos</a><a href="/contact">Contact</a></div><div><strong>CATÉGORIES</strong><% categories.slice(0, 5).forEach(category => { %><a href="/categorie/<%= category.slug %>"><%= category.nom %></a><% }) %></div></footer>
<div class="mock-copyright">ELITE24.CD · Info d'excellence <span>© <%= new Date().getFullYear() %></span></div>
</body>
</html>
