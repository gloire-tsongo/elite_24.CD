<!doctype html>
<html lang="fr">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= article ? 'Modifier' : 'Nouvel article' %> | ELITE24.CD</title><link rel="stylesheet" href="/style.css"></head>
<body><header><a class="brand" href="/">ELITE24<span>.CD</span></a><nav><a href="/admin">Tableau de bord</a><a href="/admin/logout">Déconnexion</a></nav></header>
<main class="editor"><p class="eyebrow">Studio de rédaction</p><h1><%= article ? 'Modifier l’article' : 'Nouvel article' %></h1>
<% if (error) { %><p class="error"><%= error %></p><% } %>
<form method="post" action="<%= article && article.id ? '/admin/articles/' + article.id : '/admin/articles' %>" enctype="multipart/form-data"><label>Titre<input name="titre" value="<%= article ? article.titre : '' %>" required maxlength="200"></label>
<div class="form-grid"><label>Catégorie<select name="categoryId" required><% categories.forEach(category => { %><option value="<%= category.id %>" <%= article && article.categoryId === category.id ? 'selected' : '' %>><%= category.nom %></option><% }) %></select></label><label>Statut<select name="statut"><option value="brouillon" <%= article && article.statut === 'brouillon' ? 'selected' : '' %>>Brouillon</option><option value="publie" <%= !article || article.statut === 'publie' ? 'selected' : '' %>>Publier maintenant</option><option value="archive" <%= article && article.statut === 'archive' ? 'selected' : '' %>>Archivé</option></select></label></div>
<div class="editor-field"><label for="content-editor">Contenu <span class="hint">Structurez le texte avec la barre d’outils</span></label><div class="toolbar" role="toolbar"><button type="button" data-command="bold"><b>G</b></button><button type="button" data-command="italic"><i>I</i></button><button type="button" data-command="formatBlock" data-value="p">¶</button><button type="button" data-command="formatBlock" data-value="h2">H2</button><button type="button" data-command="justifyLeft">Gauche</button><button type="button" data-command="justifyCenter">Centrer</button><button type="button" data-command="justifyFull">Justifier</button><button type="button" data-command="formatBlock" data-value="blockquote">Citation</button><button type="button" data-command="insertUnorderedList">Liste</button><button type="button" data-command="createLink">Lien</button><button type="button" data-action="insertImage">Image</button></div><div id="content-editor" class="content-editor" contenteditable="true" role="textbox" aria-multiline="true" tabindex="0"><%- article ? article.contenu : '' %></div><textarea id="content-value" name="contenu" hidden><%= article ? article.contenu : '' %></textarea><input id="editor-image-input" type="file" accept="image/*" hidden><span class="hint">Vous pouvez insérer plusieurs images à n’importe quel endroit du texte · 10 Mo maximum par image</span></div>
<div class="form-grid"><label>Image de couverture<input type="file" name="coverImage" accept="image/*"><span class="hint">Plusieurs formats image acceptés · 20 Mo maximum</span></label><label>Type de média<select name="mediaType"><option value="texte" <%= !article || article.mediaType === 'texte' ? 'selected' : '' %>>Article</option><option value="video" <%= article && article.mediaType === 'video' ? 'selected' : '' %>>TV / Vidéo YouTube</option><option value="audio" <%= article && article.mediaType === 'audio' ? 'selected' : '' %>>Podcast / Audio</option></select></label></div>
<div class="form-grid"><label>Fichier audio (podcast, 20 Mo max)<input type="file" name="audioFile" accept="audio/*"></label><label>URL du média (facultatif)<input name="mediaUrl" type="url" value="<%= article && article.mediaUrl ? article.mediaUrl : '' %>" placeholder="https://... (YouTube, podcast, MP3, etc.)"></label></div><div class="form-actions"><a href="/admin">Annuler</a><button type="submit"><%= article ? 'Enregistrer les modifications' : 'Publier l’article' %></button></div></form></main>
<script src="/editor.js" defer></script></body></html>