<!doctype html>
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Administration | ELITE24.CD</title><link rel="stylesheet" href="/style.css"></head><body><header><a class="brand" href="/">ELITE24<span>.CD</span></a><nav><a href="/">Voir le site</a><a href="/admin/logout">Déconnexion</a></nav></header><main><div class="admin-heading"><div><p class="eyebrow">Espace privé · <%= user.username %></p><h1>Rédaction</h1></div><a class="button" href="/admin/articles/new">+ Nouvel article</a></div><section class="metrics"><div><strong><%= metrics.articles %></strong><span>Articles</span></div><div><strong><%= metrics.categories %></strong><span>Catégories</span></div><div><strong><%= metrics.pendingComments %></strong><span>À modérer</span></div><div><strong><%= metrics.comments %></strong><span>Commentaires</span></div></section><section class="admin-section"><div class="section-heading"><h2>Articles récents</h2><a href="/admin/articles/new">Écrire un article</a></div><div class="admin-table"><% articleList.forEach(article => { %><div class="admin-row"><div><b><%= article.titre %></b><small><%= article.category.nom %> · <%= article.statut %> · <%= article.viewsCount %> vue(s)</small></div><div class="row-actions"><a href="/admin/articles/<%= article.id %>/edit">Modifier</a><form method="post" action="/admin/articles/<%= article.id %>/delete" onsubmit="return confirm('Supprimer cet article ?')"><button class="link-button" type="submit">Supprimer</button></form></div></div><% }) %></div></section><section class="admin-section" id="commentaires"><div class="section-heading"><h2>Commentaires à traiter</h2></div><div class="admin-table"><% commentList.forEach(comment => { %><div class="admin-row"><div><b><%= comment.authorName %></b><small><%= comment.article.titre %> · <%= comment.message.slice(0, 100) %></small></div><div class="row-actions"><form method="post" action="/admin/comments/<%= comment.id %>/status"><input type="hidden" name="statut" value="approuve"><button class="small-button" type="submit">Approuver</button></form><form method="post" action="/admin/comments/<%= comment.id %>/status"><input type="hidden" name="statut" value="rejete"><button class="link-button" type="submit">Rejeter</button></form></div></div><% }) %></div></section></main></body></html>
